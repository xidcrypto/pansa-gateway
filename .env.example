# Server
PORT=3000
NODE_ENV=development

# Master key server-to-server (opsional). Kalau diset, header x-api-key = akses admin penuh.
# Frontend user biasa pakai JWT dari /auth/login — TIDAK butuh ini.
API_KEY=

# JWT untuk login user (WAJIB diisi di production, min 32 char acak)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=wa_gateway
DB_POOL=10

# Seed admin pertama (hanya dipakai kalau tabel users masih kosong).
# Kalau ADMIN_PASS dikosongkan, password di-generate & ditampilkan sekali di console.
ADMIN_USER=admin
ADMIN_PASS=

# Webhook global (fallback kalau user tidak set webhook sendiri di profilnya)
WEBHOOK_URL=
WEBHOOK_SECRET=

SESSION_DIR=./sessions
# Folder sandbox untuk media { path } — file di luar sini DITOLAK
MEDIA_DIR=./media
# Matikan akses file lokal sepenuhnya: MEDIA_ALLOW_PATH=0
MEDIA_ALLOW_PATH=1
MAX_MEDIA_BYTES=67108864

# Session default TIDAK dipakai lagi (multi-user pakai POST /sessions). Dibiarkan untuk kompat.
DEFAULT_SESSION=default
RECENT_LIMIT=100

# CORS: '*' untuk dev. Production: isi domain frontend, cth https://app.kamu.id
CORS_ORIGIN=*

# Rate limit
RATE_WINDOW_MS=900000
RATE_MAX=1000
RATE_AUTH_MAX=30
RATE_PAIR_MAX=20

LOG_LEVEL=info
